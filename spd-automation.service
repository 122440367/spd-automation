[Unit]
Description=Upload today's ASN CSV files to SPD, run speed tests, and publish to GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/spd-automation
EnvironmentFile=/etc/spd-automation.env
Environment=TZ=Asia/Shanghai
ExecStart=/usr/bin/python3 /opt/spd-automation/spd_automation.py
TimeoutStartSec=25min

# Basic hardening. The job reads CSV files and writes only its lock/state directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/root/ASNIPtest
ReadWritePaths=/var/lib/spd-automation

[Install]
WantedBy=multi-user.target
