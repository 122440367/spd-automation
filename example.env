# 复制为 .env 后填写。SPD_URL 和 SPD_API_TOKEN 是必填项。

# 必填：Worker 地址。请替换为自己的地址，建议保留末尾斜杠。
SPD_URL=https://your-spd-domain.example/

# 必填：与 Cloudflare Worker Secret SPD_API_TOKEN 完全相同的随机长密钥。
# 不要把真实 Token 提交到 Git。
SPD_API_TOKEN=replace_with_a_random_long_token

# 可选：CSV 目录。默认值：/root/ASNIPtest
# SPD_CSV_DIR=/root/ASNIPtest

# 可选：上传解析超时（秒）。默认值：300
# SPD_UPLOAD_TIMEOUT_SECONDS=300

# 可选：测速超时（秒）。默认值：600
# SPD_SPEEDTEST_TIMEOUT_SECONDS=600

# 可选：每次最多测试的 IP 数量。默认值：25；Worker 上限：50
# SPD_MAX_TESTS=25

# 可选：上传到 GitHub 的超时（秒）。默认值：300
# SPD_GITHUB_TIMEOUT_SECONDS=300

# 可选：CSV 上传前必须保持不变的时间（秒）。默认值：5
# SPD_FILE_STABLE_SECONDS=5

# 可选：等待 CSV 稳定的最长时间（秒）。默认值：60
# SPD_FILE_STABLE_TIMEOUT_SECONDS=60

# 可选：Telegram 执行结果通知及私聊 /cleanup 命令。默认值：不启用
# 启用时必须同时取消下面两行的注释并填写真实值。chat_id 必须是你的私人聊天 ID。
# bot_token=replace_with_your_bot_token
# chat_id=replace_with_your_chat_id
